#include <stdio.h>

int main() {
    int arr[5] = {10, 20, 30, 40, 50};
    int size = 5;
    int target = 30; // The value we are searching for
    int foundIndex = -1; // -1 means "not found"

    // Search loop: check elements one by one
    for (int i = 0; i < size; i++) {
        if (arr[i] == target) {
            foundIndex = i; // Save the location where target was found
            break;         // Stop searching once found
        }
    }

    if (foundIndex != -1) {
        printf("Element %d found at index %d.\n", target, foundIndex);
    } else {
        printf("Element %d not found in the array.\n", target);
    }

    return 0;
}
